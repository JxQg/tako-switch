{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tako Switch",
  "version": "2.0.5",
  "identifier": "tech.shiroha.tako-switch",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tako Switch",
        "width": 760,
        "height": 620,
        "minWidth": 720,
        "minHeight": 540,
        "resizable": true,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 24 },
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE4RThFNDRDREZCRTI2NTUKUldSVkpyN2ZUT1RvcU9uWTU2NVhJQnR6cWxMckF5R1ZsV2ZkSnhFNjVNT0tSUDY0TVBPUENRZFgK",
      "endpoints": [
        "https://dsh-tako-dl.oss-cn-shanghai.aliyuncs.com/tako-switch/latest.json",
        "https://github.com/tako-dev/tako-switch/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
